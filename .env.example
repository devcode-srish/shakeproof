# ---- Chain (Monad testnet defaults) ----
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_TX_BASE=https://testnet.monadvision.com/tx/

# ---- Deployed contract (fill after `npm run contract:deploy`) ----
NEXT_PUBLIC_SHAKEPROOF_ADDRESS=

# ---- Relayer: server-side wallet that pays gas for handshakes (testnet key only!) ----
RELAYER_PRIVATE_KEY=

# ---- Proximity proof: set to "false" for indoor/desktop demos ----
REQUIRE_PROXIMITY=true
MAX_DISTANCE_METERS=100

# ---- Optional: Claude-generated icebreakers (falls back to curated deck) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
